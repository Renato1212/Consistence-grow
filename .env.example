# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (public: safe in the browser, protected by RLS) ---
# Local stack: run `pnpm db:start` and copy API_URL / PUBLISHABLE_KEY from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only secrets (Vercel env vars; never prefix with NEXT_PUBLIC_) ---
# Needed from Phase 8 (backups cron) — Supabase secret key.
SUPABASE_SECRET_KEY=
# Needed from Phase 7 (AI analysis).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Protects the /api/cron/* routes (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# --- Tests only ---
# Path to a pre-installed Chromium (cloud dev containers). Leave empty on CI.
PW_CHROMIUM_PATH=
